# Supabase — fill these in once the project is created (Project Settings → API).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only secret (Project Settings → API → service_role). Lets admins change staff
# emails/passwords. Never prefix with NEXT_PUBLIC_ and never commit the real value.
SUPABASE_SERVICE_ROLE_KEY=
